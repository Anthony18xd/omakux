  "editor.tokenColorCustomizations": {
    "comments": "{{color_muted}}",
    "strings": "{{color_green}}",
    "numbers": "{{color_orange}}",
    "keywords": "{{color_magenta}}",
    "functions": "{{color_blue}}",
    "variables": "{{color_fg}}",
    "textMateRules": [
      {
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "{{color_muted}}", "fontStyle": "italic" }
      },
      {
        "scope": ["string", "constant.other.symbol"],
        "settings": { "foreground": "{{color_green}}" }
      },
      {
        "scope": ["constant.numeric", "constant.language"],
        "settings": { "foreground": "{{color_orange}}" }
      },
      {
        "scope": ["keyword", "storage.type", "storage.modifier"],
        "settings": { "foreground": "{{color_magenta}}" }
      },
      {
        "scope": ["entity.name.function", "support.function"],
        "settings": { "foreground": "{{color_blue}}" }
      },
      {
        "scope": ["variable", "entity.name.variable"],
        "settings": { "foreground": "{{color_fg}}" }
      },
      {
        "scope": ["invalid", "invalid.deprecated"],
        "settings": { "foreground": "{{color_red}}" }
      },
      {
        "scope": ["markup.inserted", "diff.inserted"],
        "settings": { "foreground": "{{color_green}}" }
      },
      {
        "scope": ["markup.deleted", "diff.deleted"],
        "settings": { "foreground": "{{color_red}}" }
      },
      {
        "scope": ["markup.changed", "diff.changed"],
        "settings": { "foreground": "{{color_yellow}}" }
      }
    ]
  },
  "editorBracketHighlighting.foreground1": "{{color_yellow}}",
  "editorBracketHighlighting.foreground2": "{{color_magenta}}",
  "editorBracketHighlighting.foreground3": "{{color_blue}}",
  "editorBracketHighlighting.foreground4": "{{color_orange}}",
  "editorBracketHighlighting.foreground5": "{{color_cyan}}",
  "editorBracketHighlighting.foreground6": "{{color_green}}",
  "editor.colorTheme": "{{vscode_theme}}",
  "terminal.integrated.fontFamily": "JetBrains Mono",
  "terminal.integrated.fontSize": 13,
  "editor.fontFamily": "JetBrains Mono",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "workbench.startupEditor": "none",
  "window.titleBarStyle": "custom",
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "explorer.confirmDelete": false
}
