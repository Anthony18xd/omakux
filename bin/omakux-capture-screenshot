#!/usr/bin/env bash
# omakux:summary Take a screenshot: omakux capture [area|full|screen]
# omakux:group capture
set -euo pipefail

OMAKUX_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OMAKUX_PATH="${OMAKUX_PATH:-$(dirname "$OMAKUX_BIN")}"
export OMAKUX_PATH

mode="${1:-area}"
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Imágenes")/Capturas"
mkdir -p "$dir"
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"

if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && command -v grim >/dev/null 2>&1; then
  exec "$OMAKUX_PATH/config-themes/hypr/scripts/screenshot.sh" "$mode"
fi

# GNOME / otro Wayland: gnome-screenshot
if command -v gnome-screenshot >/dev/null 2>&1; then
  case "$mode" in
    area) gnome-screenshot -a -f "$file" ;;
    *) gnome-screenshot -f "$file" ;;
  esac
  if [ -f "$file" ]; then
    command -v wl-copy >/dev/null 2>&1 && wl-copy <"$file" || true
    notify-send -u low -h string:x-canonical-private-synchronous:screenshot \
      -i "$file" "Captura guardada" "$file" 2>/dev/null || true
    echo "$file"
  fi
  exit 0
fi

echo "no hay herramienta de captura disponible (grim o gnome-screenshot)" >&2
exit 1
